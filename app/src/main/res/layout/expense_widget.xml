<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/expense_widget_title"
            android:textSize="11sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:id="@+id/widget_today_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/widget_expense_red"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <Button
        android:id="@+id/widget_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/expense_widget_add"
        android:textSize="12sp"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:backgroundTint="@color/widget_expense_red"
        android:radius="12dp" />

</LinearLayout>
