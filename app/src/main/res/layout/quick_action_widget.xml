<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_action_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_card_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quick Actions"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2"
        android:gravity="center">

        <Button
            android:id="@+id/widget_action_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="@string/income_widget_add"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="@color/widget_income_green"
            android:radius="12dp" />

        <Button
            android:id="@+id/widget_action_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/expense_widget_add"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:backgroundTint="@color/widget_expense_red"
            android:radius="12dp" />

    </LinearLayout>

</LinearLayout>
